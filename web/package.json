    "@playwright/test": "^1.64.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
