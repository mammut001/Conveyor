[Unit]
Description=Conveyor: always-on agent desktops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=CONVEYOR_DIR=/opt/conveyor
EnvironmentFile=-/etc/default/conveyor
WorkingDirectory=/opt/conveyor
EnvironmentFile=/opt/conveyor/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/conveyor/.venv/bin/python /opt/conveyor/agent_desktops.py
Restart=always
RestartSec=3
# Desktops outlive the supervisor: a deploy restarts this unit, and that must
# not close anybody's windows. The new process adopts what is running.
KillMode=process
# Deliberately no NoNewPrivileges / ProtectHome: snap-packaged browsers start
# through a setuid helper and keep their profile under the home directory.
# The supervisor passes desktop programs a minimal environment (no .env secrets).

[Install]
WantedBy=multi-user.target
