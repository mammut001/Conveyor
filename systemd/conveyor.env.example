# /etc/default/conveyor
#
# Optional override file for the systemd units in this directory.
# Copy to /etc/default/conveyor (without the .example suffix) and
# edit to override the install path. The systemd units default to
# /opt/conveyor if this file is missing.
#
# After editing, reload systemd and restart the affected units:
#   sudo systemctl daemon-reload
#   sudo systemctl restart conveyor-telegram-bot.service
#   sudo systemctl restart conveyor-maintain.service
#
# /srv and /home/ubuntu in the .service files' ReadWritePaths are
# intentional VPS paths (snapshot + codex home); if you install on a
# machine with a different layout, edit the .service files directly.

# Install path of the cloned repo. Must be an absolute path.
# CONVEYOR_DIR=/opt/conveyor

# Web Console remains disabled until explicitly configured in /opt/conveyor/.env.
# Keep it on loopback and access through an SSH tunnel or a private network.
# CONVEYOR_WEB_ENABLED=false
# CONVEYOR_WEB_HOST=127.0.0.1
# CONVEYOR_WEB_PORT=8787
# Kill switch for Secure Human Takeover (web routes + sidecar transport, default false).
# CONVEYOR_TAKEOVER_ENABLED=false
# General Routines (scheduled chat-tier tasks + tools, default false).
# CONVEYOR_ROUTINES_ENABLED=false
# Lifetime of routine-generated approvals (seconds, 300..604800; default 24h)
# CONVEYOR_ROUTINES_APPROVAL_TTL_SECONDS=86400
# MCP Connectors (stdio & streamable HTTP, chat tier integration, default false).
# CONVEYOR_MCP_ENABLED=false
# Path to MCP servers JSON configuration (default: <codex_memory_root>/mcp_servers.json).
# CONVEYOR_MCP_CONFIG=

# Web-only deployment note:
# For web-only deployments without Telegram, minimal .env configuration:
#   CODEX_WORKSPACE_ROOT=/path/to/workspace
#   CONVEYOR_WEB_ENABLED=true
#   CONVEYOR_WEB_TOKEN=<secret-at-least-32-chars>
#   CONVEYOR_WEB_HOST=127.0.0.1
#   CONVEYOR_WEB_PORT=8787
# (TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_USER_ID are optional for web console)
